<Window x:Class="YuiTracking.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:Microsoft.UI.Xaml.Controls" Title="YuiTracking">
 <Grid x:Name="Root" Background="#10121B" RequestedTheme="Dark" Padding="16">
  <Grid x:Name="MainContent" ColumnSpacing="16">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="SettingsColumn" Width="300"/></Grid.ColumnDefinitions>
   <Grid x:Name="PreviewPanel" RowSpacing="8">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border x:Name="PreviewBorder" CornerRadius="10" Background="#191D2B" BorderBrush="#2D3447" BorderThickness="1">
     <Grid>
      <controls:WebView2 x:Name="Viewport"/>
      <StackPanel x:Name="RendererFailurePanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" Spacing="16" MaxWidth="480">
       <TextBlock Text="描画が停止しました" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <TextBlock x:Name="RendererFailureMessage" Text="アプリを再起動しますか？保存したVRMと設定は引き継がれます。" TextWrapping="Wrap" Foreground="#ADB6CD"/>
       <Button x:Name="RestartButton" ToolTipService.ToolTip="アプリを再起動して、描画の復帰を試みます。&#10;保存済みのアバターと設定を引き継ぎます。" Content="YuiTrackingを再起動する" Click="Restart_Click"/>
      </StackPanel>
     </Grid>
    </Border>
    <Border x:Name="PreviewStatus" Grid.Row="1" Padding="12,8" Background="#1A1E2B" CornerRadius="8">
     <Grid RowSpacing="6">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid ColumnSpacing="6">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Button Content="キャリブレーション" HorizontalAlignment="Stretch" ToolTipService.ToolTip="今の顔・体の向きと目の開き具合を基準に合わせます。&#10;正面を向いて実行してください。&#10;ショートカット：右Ctrl／右Shift" Click="Calibrate_Click"/>
       <Button Grid.Column="1" Content="初期位置に戻す" Click="ResetFraming_Click" ToolTipService.ToolTip="拡大率・移動位置・カメラの回転を、&#10;最初の状態に戻します。"/>
       <Button Grid.Column="2" Content="最大化" Click="MaximizePreview_Click" ToolTipService.ToolTip="プレビューを最大化します。&#10;Esc：元に戻す&#10;ダブルクリックでも切り替えられます。"/>
       <ToggleButton x:Name="Privacy" Grid.Column="3" VerticalAlignment="Center" Content="待機画面" ToolTipService.ToolTip="待機画面に切り替えます。&#10;オンの間はアバターの代わりに待機画面を出力します。" Click="Privacy_Click"/>
      </Grid>
      <Grid Grid.Row="1" ColumnSpacing="12">
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MaxWidth="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock x:Name="TrackingStatus" Text="描画エンジンを準備しています…" TextTrimming="CharacterEllipsis" FontSize="12" ToolTipService.ToolTip="{Binding Text, ElementName=TrackingStatus}"/>
       <TextBlock x:Name="OutputStatus" Grid.Column="1" Text="仮想カメラ：停止中" Foreground="#9DA7C0" TextTrimming="CharacterEllipsis" FontSize="12" ToolTipService.ToolTip="{Binding Text, ElementName=OutputStatus}"/>
       <TextBlock x:Name="MemoryStatus" Grid.Column="2" Text="メモリ：計測中" Foreground="#9DA7C0" FontSize="12" ToolTipService.ToolTip="本体と関連WebView2のメモリ使用量を合計します。"/>
      </Grid>
     </Grid>
    </Border>
   </Grid>
   <Grid x:Name="SettingsPanel" Grid.Column="1" RowSpacing="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Spacing="6">
     <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="Cameras" ToolTipService.ToolTip="トラッキングに使うカメラを選びます。&#10;「カメラを開始」を押すと映像の認識を始めます。" PlaceholderText="カメラを選択" HorizontalAlignment="Stretch" DisplayMemberPath="Label"/><Button x:Name="TrackButton" ToolTipService.ToolTip="選択したカメラで顔・手・体の認識を開始します。&#10;認識した動きをアバターに反映します。" Grid.Column="1" Content="カメラを開始" Click="Track_Click" IsEnabled="False"/></Grid>
     <TextBlock x:Name="CameraInputStatus" Text="カメラ入力：720p / 最大30fps" Foreground="#9DA7C0" FontSize="12" TextWrapping="Wrap"/>
     <TextBlock x:Name="HandDetectionStatus" Text="手：カメラ停止中" Foreground="#9DA7C0" FontSize="12"/>
    </StackPanel>
    <Grid Grid.Row="1" RowSpacing="0">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid ColumnSpacing="4">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ToggleButton CornerRadius="8,8,0,0" x:Name="AvatarTab" ToolTipService.ToolTip="アバター・背景の選択と、&#10;OBS向けの仮想カメラ出力を設定します。" Content="アバター・出力" Tag="avatar" IsChecked="True" Click="SettingsTab_Click" HorizontalAlignment="Stretch" Padding="6,8" FontSize="12"/>
      <ToggleButton CornerRadius="8,8,0,0" x:Name="MotionTab" ToolTipService.ToolTip="動きの滑らかさ、顔・口の反応、&#10;髪や服の揺れを調整します。" Grid.Column="1" Content="動きの調整" Tag="motion" Click="SettingsTab_Click" HorizontalAlignment="Stretch" Padding="6,8" FontSize="12"/>
     </Grid>
      <Border Grid.Row="1" BorderBrush="#48BDF5" BorderThickness="1" CornerRadius="0,0,8,8" Background="#171B27" Padding="10,12,10,10">
       <Grid>
      <ScrollViewer x:Name="AvatarSettings" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="6">
      <Button x:Name="ModelButton" ToolTipService.ToolTip="PCに保存したVRMファイルを開いて、&#10;使用するアバターを切り替えます。" Content="VRMを開く" HorizontalAlignment="Stretch" Click="OpenModel_Click" IsEnabled="False"/>
      <TextBlock x:Name="ModelLabel" Text="サンプルを準備中" Foreground="#9DA7C0" TextTrimming="CharacterEllipsis" FontSize="12"/>
      <TextBlock Text="サンプル" ToolTipService.ToolTip="同梱のアバターに切り替えます。&#10;青色のボタンが現在の選択です。" Foreground="#9DA7C0" FontSize="12"/>
       <Grid ColumnSpacing="6">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <ToggleButton x:Name="SampleGirl" ToolTipService.ToolTip="女の子のサンプル（Y）に切り替えます。&#10;選択中のボタンは青色で表示します。" Content="女の子" Tag="Y" Click="Sample_Click" HorizontalAlignment="Stretch" Padding="6,4"/>
       <ToggleButton x:Name="SampleBoy" ToolTipService.ToolTip="男の子のサンプル（Z）に切り替えます。&#10;選択中のボタンは青色で表示します。" Grid.Column="1" Content="男の子" Tag="Z" Click="Sample_Click" HorizontalAlignment="Stretch" Padding="6,4"/>
       <ToggleButton x:Name="SampleRobot" ToolTipService.ToolTip="内蔵ロボットに切り替えます。&#10;選択中のボタンは青色で表示します。" Grid.Column="2" Content="ロボット" Click="Demo_Click" HorizontalAlignment="Stretch" Padding="6,4"/>
       </Grid>
       <TextBlock Text="背景" ToolTipService.ToolTip="プレビューと配信出力の背景色を選びます。&#10;青色のボタンが現在の選択です。" Foreground="#9DA7C0" FontSize="12" Margin="0,12,0,0"/>
       <Grid ColumnSpacing="6" RowSpacing="6">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ToggleButton x:Name="BackgroundTransparent" Grid.Row="0" Grid.Column="0" Content="透過" Tag="transparent" Click="Background_Click" HorizontalAlignment="Stretch" Padding="6,4" ToolTipService.ToolTip="透明な背景でアバターを出力します。&#10;OBSの「映像キャプチャデバイス」で&#10;「YuiTracking Camera」を選択し、&#10;映像フォーマットを「ARGB」にしてください。&#10;必要に応じて解像度/FPSタイプを「カスタム」にし、&#10;解像度を1280×720に設定してください。"/>
        <ToggleButton x:Name="BackgroundGreen" Grid.Row="0" Grid.Column="1" Content="グリーン" Tag="#00ff00" IsChecked="True" Click="Background_Click" HorizontalAlignment="Stretch" Padding="6,4" ToolTipService.ToolTip="背景をグリーンにします。&#10;OBSのクロマキーで背景を抜くときに使えます。"/>
        <ToggleButton x:Name="BackgroundImage" Grid.Row="0" Grid.Column="2" Content="背景を選択" Click="BackgroundImage_Click" HorizontalAlignment="Stretch" Padding="4,4" FontSize="12" ToolTipService.ToolTip="画像ファイルを選んで背景にします。&#10;PNG・JPEG・BMPに対応します。&#10;画像は比率を保って画面全体に配置します。"/>
        <ToggleButton x:Name="BackgroundRed" Grid.Row="1" Grid.Column="0" Content="レッド" Tag="#ff0000" Click="Background_Click" HorizontalAlignment="Stretch" Padding="6,4" ToolTipService.ToolTip="背景をレッドにします。&#10;OBSのカラーキーで背景を抜くときに使えます。"/>
        <ToggleButton x:Name="BackgroundBlue" Grid.Row="1" Grid.Column="1" Content="ブルー" Tag="#0000ff" Click="Background_Click" HorizontalAlignment="Stretch" Padding="6,4" ToolTipService.ToolTip="背景をブルーにします。&#10;アバターに緑色が多い場合のクロマキーに使えます。"/>
        <ToggleButton x:Name="BackgroundBlack" Grid.Row="1" Grid.Column="2" Content="ブラック" Tag="#000000" Click="Background_Click" HorizontalAlignment="Stretch" Padding="6,4" ToolTipService.ToolTip="背景をブラックにします。&#10;背景を抜かずに表示するときに使えます。"/>
       </Grid>
       <Button x:Name="OutputButton" Content="仮想カメラ出力を開始" Click="Output_Click" HorizontalAlignment="Stretch" IsEnabled="False" ToolTipService.ToolTip="アバター映像を仮想カメラへ出力します。&#10;OBSで「映像キャプチャデバイス」を追加し、&#10;「YuiTracking Camera」を選択してください。"/>
       <Button x:Name="RegisterButton" ToolTipService.ToolTip="OBSなどから使える仮想カメラを登録します。&#10;初回のみ実行してください。" Content="仮想カメラを登録（初回）" Click="Register_Click" HorizontalAlignment="Stretch"/>
      </StackPanel>
      </ScrollViewer>
      <ScrollViewer x:Name="MotionSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="4">
       <StackPanel Background="Transparent" ToolTipService.ToolTip="認識結果の間を滑らかにつなぎます。&#10;0%：補間なし（比較用）&#10;大きいほど滑らかになり、追従はゆっくりになります。">
        <TextBlock x:Name="SmoothnessLabel" Text="滑らかさ：65%" Foreground="#9DA7C0"/>
        <Slider x:Name="Smoothness" ToolTipService.ToolTip="認識結果の間を滑らかにつなぎます。&#10;0%：補間なし（比較用）&#10;大きいほど滑らかになり、追従はゆっくりになります。" Minimum="0" Maximum="0.95" Value="0.65" StepFrequency="0.05" ValueChanged="Settings_Changed"/>
       </StackPanel>
       <StackPanel Background="Transparent" ToolTipService.ToolTip="認識した口の開きに対する、アバターの変形量です。&#10;大きく：アバターの口が大きく開く&#10;小さく：アバターの口の開きが控えめになる">
        <TextBlock x:Name="MouthStrengthLabel" Text="口の開き具合：1.0倍" Foreground="#9DA7C0"/>
        <Slider x:Name="MouthStrength" ToolTipService.ToolTip="認識した口の開きに対する、アバターの変形量です。&#10;大きく：アバターの口が大きく開く&#10;小さく：アバターの口の開きが控えめになる" Minimum="0.5" Maximum="3" Value="1" StepFrequency="0.1" ValueChanged="MouthStrength_Changed"/>
       </StackPanel>
       <StackPanel Background="Transparent" ToolTipService.ToolTip="自分の口の動きを拾う感度を調整します。&#10;大きく：小さな動きでも口が開きやすい&#10;小さく：しっかり口を動かすと反応する">
        <TextBlock x:Name="MouthSensitivityLabel" Text="口の感度：1.8倍" Foreground="#9DA7C0"/>
        <Slider x:Name="MouthSensitivity" ToolTipService.ToolTip="自分の口の動きを拾う感度を調整します。&#10;大きく：小さな動きでも口が開きやすい&#10;小さく：しっかり口を動かすと反応する" Minimum="0.5" Maximum="3" Value="1.8" StepFrequency="0.1" ValueChanged="MouthStrength_Changed"/>
       </StackPanel>
       <StackPanel Background="Transparent" ToolTipService.ToolTip="モデルに設定された胸・髪・服などの揺れを調整します。">
        <TextBlock x:Name="SpringStrengthLabel" Text="揺れものの強さ：1.0倍" Foreground="#9DA7C0"/>
        <Slider x:Name="SpringStrength" Minimum="0.3" Maximum="5" Value="1" StepFrequency="0.1" ToolTipService.ToolTip="モデルに設定された胸・髪・服などの揺れを調整します。" ValueChanged="SpringStrength_Changed"/>
       </StackPanel>
       <StackPanel Background="Transparent" ToolTipService.ToolTip="頭の向き・傾きを反映する強さです。&#10;1倍：今までと同じ／大きく：動きを強調／小さく：控えめ">
        <TextBlock x:Name="SensitivityLabel" Text="顔の動きの強さ：1.0倍" Foreground="#9DA7C0"/>
        <Slider x:Name="Sensitivity" ToolTipService.ToolTip="頭の向き・傾きを反映する強さです。&#10;1倍：今までと同じ／大きく：動きを強調／小さく：控えめ" Minimum="0.3" Maximum="2" Value="1" StepFrequency="0.1" ValueChanged="FaceSensitivity_Changed"/>
        <TextBlock x:Name="BodyStrengthLabel" Text="体の動きの強さ：1.0倍" Foreground="#9DA7C0"/>
        <Slider x:Name="BodyStrength" Minimum="0" Maximum="15" Value="1" StepFrequency="0.1" ToolTipService.ToolTip="頭に連動する体の左右のひねりを調整します。&#10;1倍：今までと同じ／約13.3倍：顔45度で体180度（左右180度まで）。0倍：左右のひねりなし。頭の向き・前後の傾きは変わりません。" ValueChanged="FaceSensitivity_Changed"/>
       </StackPanel>
      </StackPanel>
      </ScrollViewer>
       </Grid>
      </Border>
    </Grid>
   </Grid>
  </Grid>
 </Grid>
</Window>
