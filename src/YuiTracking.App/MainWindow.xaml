<Window x:Class="YuiTracking.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:Microsoft.UI.Xaml.Controls" Title="YuiTracking">
 <Grid x:Name="Root" Background="#10121B" RequestedTheme="Dark" Padding="16">
  <Grid x:Name="MainContent" ColumnSpacing="16">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="SettingsColumn" Width="300"/></Grid.ColumnDefinitions>
   <Grid x:Name="PreviewPanel" RowSpacing="8">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border x:Name="PreviewBorder" CornerRadius="10" Background="#191D2B" BorderBrush="#2D3447" BorderThickness="1">
     <Grid>
      <controls:WebView2 x:Name="Viewport"/>
      <StackPanel x:Name="RendererFailurePanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" Spacing="16" MaxWidth="480">
       <TextBlock Text="描画が停止しました" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <TextBlock x:Name="RendererFailureMessage" Text="アプリを再起動しますか？保存したVRMと設定は引き継がれます。" TextWrapping="Wrap" Foreground="#ADB6CD"/>
       <Button x:Name="RestartButton" ToolTipService.ToolTip="アプリを再起動して、描画の復帰を試みます。&#10;保存済みのアバターと設定を引き継ぎます。" Content="YuiTrackingを再起動する" Click="Restart_Click"/>
      </StackPanel>
     </Grid>
    </Border>
    <Border x:Name="PreviewStatus" Grid.Row="1" Padding="12,8" Background="#1A1E2B" CornerRadius="8">
     <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Spacing="6" VerticalAlignment="Center">
       <Grid ColumnSpacing="6">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button Content="正面をキャリブレーション" HorizontalAlignment="Stretch" ToolTipService.ToolTip="今の顔の向きを正面として合わせます。&#10;正面を向いて実行してください。&#10;ショートカット：右Ctrl／右Shift&#10;どちらかを単独で押して離すと実行します。" Click="Calibrate_Click"/>
        <Button Grid.Column="1" Content="最大化" Click="MaximizePreview_Click" ToolTipService.ToolTip="プレビューを最大化します。&#10;Esc：元に戻す&#10;ダブルクリックでも切り替えられます。"/>
       </Grid>
       <TextBlock x:Name="TrackingStatus" Text="描画エンジンを準備しています…" TextWrapping="Wrap" FontSize="12"/>
       <TextBlock x:Name="OutputStatus" Text="仮想カメラ：停止中" Foreground="#9DA7C0" TextWrapping="Wrap" FontSize="12"/>
      </StackPanel>
      <ToggleSwitch x:Name="Privacy" Grid.Column="1" VerticalAlignment="Center" Header="待機画面" OffContent="オフ" OnContent="オン" ToolTipService.ToolTip="アバター出力を待機画面に切り替えます" Toggled="Privacy_Toggled"/>
     </Grid>
    </Border>
   </Grid>
   <Grid x:Name="SettingsPanel" Grid.Column="1" RowSpacing="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Spacing="6">
     <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="Cameras" ToolTipService.ToolTip="トラッキングに使うカメラを選びます。&#10;「カメラを開始」を押すと映像の認識を始めます。" PlaceholderText="カメラを選択" HorizontalAlignment="Stretch" DisplayMemberPath="Label"/><Button x:Name="TrackButton" ToolTipService.ToolTip="選択したカメラで顔・手・体の認識を開始します。&#10;認識した動きをアバターに反映します。" Grid.Column="1" Content="カメラを開始" Click="Track_Click" IsEnabled="False"/></Grid>
     <TextBlock x:Name="CameraInputStatus" Text="カメラ入力：720p / 最大30fps" Foreground="#9DA7C0" FontSize="12" TextWrapping="Wrap"/>
    </StackPanel>
    <Grid Grid.Row="1" RowSpacing="12">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid ColumnSpacing="4">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ToggleButton x:Name="AvatarTab" ToolTipService.ToolTip="アバター・背景の選択と、&#10;OBS向けの仮想カメラ出力を設定します。" Content="アバター・出力" Tag="avatar" IsChecked="True" Click="SettingsTab_Click" HorizontalAlignment="Stretch" Padding="6,8" FontSize="12"/>
      <ToggleButton x:Name="MotionTab" ToolTipService.ToolTip="動きの滑らかさ、顔・口の反応、&#10;髪や服の揺れを調整します。" Grid.Column="1" Content="動きの調整" Tag="motion" Click="SettingsTab_Click" HorizontalAlignment="Stretch" Padding="6,8" FontSize="12"/>
     </Grid>
      <ScrollViewer x:Name="AvatarSettings" Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="6">
      <Button x:Name="ModelButton" ToolTipService.ToolTip="PCに保存したVRMファイルを開いて、&#10;使用するアバターを切り替えます。" Content="VRMを開く" HorizontalAlignment="Stretch" Click="OpenModel_Click" IsEnabled="False"/>
      <TextBlock x:Name="ModelLabel" Text="サンプルを準備中" Foreground="#9DA7C0" TextTrimming="CharacterEllipsis" FontSize="12"/>
      <TextBlock Text="サンプル" Foreground="#9DA7C0" FontSize="12"/>
       <Grid ColumnSpacing="6">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <ToggleButton x:Name="SampleGirl" ToolTipService.ToolTip="女の子のサンプル（Y）に切り替えます。&#10;選択中のボタンは青色で表示します。" Content="女の子" Tag="Y" Click="Sample_Click" HorizontalAlignment="Stretch" Padding="6,4"/>
       <ToggleButton x:Name="SampleBoy" ToolTipService.ToolTip="男の子のサンプル（Z）に切り替えます。&#10;選択中のボタンは青色で表示します。" Grid.Column="1" Content="男の子" Tag="Z" Click="Sample_Click" HorizontalAlignment="Stretch" Padding="6,4"/>
       <ToggleButton x:Name="SampleRobot" ToolTipService.ToolTip="内蔵ロボットに切り替えます。&#10;選択中のボタンは青色で表示します。" Grid.Column="2" Content="ロボット" Click="Demo_Click" HorizontalAlignment="Stretch" Padding="6,4"/>
       </Grid>
       <TextBlock Text="背景" Foreground="#9DA7C0" FontSize="12" Margin="0,12,0,0"/>
       <Grid ColumnSpacing="6">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <ToggleButton x:Name="BackgroundGreen" ToolTipService.ToolTip="背景をグリーンにします。&#10;OBSのクロマキーで背景を抜くときに使えます。" Content="グリーン" Tag="#00ff00" IsChecked="True" Click="Background_Click" HorizontalAlignment="Stretch" Padding="6,4"/>
        <ToggleButton x:Name="BackgroundBlue" ToolTipService.ToolTip="背景をブルーにします。&#10;アバターに緑色が多い場合のクロマキーに使えます。" Grid.Column="1" Content="ブルー" Tag="#0000ff" Click="Background_Click" HorizontalAlignment="Stretch" Padding="6,4"/>
        <ToggleButton x:Name="BackgroundDark" Grid.Column="2" Content="暗色" Tag="#171b2e" Click="Background_Click" HorizontalAlignment="Stretch" Padding="6,4" ToolTipService.ToolTip="背景を暗い紺色にします。&#10;背景を抜かずに表示するときに使えます。"/>
       </Grid>
       <Button x:Name="OutputButton" Content="仮想カメラ出力を開始" Click="Output_Click" HorizontalAlignment="Stretch" IsEnabled="False" ToolTipService.ToolTip="アバター映像を仮想カメラへ出力します。&#10;OBSで「映像キャプチャデバイス」を追加し、&#10;「YuiTracking Camera」を選択してください。"/>
       <Button x:Name="RegisterButton" ToolTipService.ToolTip="OBSなどから使える仮想カメラを登録します。&#10;初回のみ実行してください。" Content="仮想カメラを登録（初回）" Click="Register_Click" HorizontalAlignment="Stretch"/>
      </StackPanel>
      </ScrollViewer>
      <ScrollViewer x:Name="MotionSettings" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="4">
       <TextBlock x:Name="SmoothnessLabel" Text="滑らかさ：65%" Foreground="#9DA7C0"/><Slider x:Name="Smoothness" ToolTipService.ToolTip="動きの揺れを抑える強さを調整します。&#10;大きく：滑らかになる／反応はゆっくり&#10;小さく：素早く反応する／細かな揺れが出やすい" Minimum="0" Maximum="0.95" Value="0.65" StepFrequency="0.05" ValueChanged="Settings_Changed"/>
       <TextBlock x:Name="MouthStrengthLabel" Text="口の開き具合：1.0倍" Foreground="#9DA7C0"/><Slider x:Name="MouthStrength" ToolTipService.ToolTip="認識した口の開きに対する、アバターの変形量です。&#10;大きく：アバターの口が大きく開く&#10;小さく：アバターの口の開きが控えめになる" Minimum="0.5" Maximum="3" Value="1" StepFrequency="0.1" ValueChanged="MouthStrength_Changed"/>
       <TextBlock x:Name="MouthSensitivityLabel" Text="口の感度：1.8倍" Foreground="#9DA7C0"/><Slider x:Name="MouthSensitivity" ToolTipService.ToolTip="自分の口の動きを拾う感度を調整します。&#10;大きく：小さな動きでも口が開きやすい&#10;小さく：しっかり口を動かすと反応する" Minimum="0.5" Maximum="3" Value="1.8" StepFrequency="0.1" ValueChanged="MouthStrength_Changed"/>
       <TextBlock x:Name="SpringStrengthLabel" Text="揺れものの強さ：1.0倍" Foreground="#9DA7C0"/><Slider x:Name="SpringStrength" Minimum="0.3" Maximum="3" Value="1" StepFrequency="0.1" ToolTipService.ToolTip="髪・服などの揺れやすさを調整します。&#10;1.0倍：モデル標準&#10;大きく：揺れやすくなる&#10;小さく：揺れが控えめになる" ValueChanged="SpringStrength_Changed"/>
       <TextBlock x:Name="SensitivityLabel" Text="顔の動きの強さ：1.0倍" Foreground="#9DA7C0"/><Slider x:Name="Sensitivity" ToolTipService.ToolTip="顔の向きや傾きを反映する強さを調整します。&#10;大きく：アバターの顔の動きが大きくなる&#10;小さく：アバターの顔の動きが控えめになる" Minimum="0.3" Maximum="2" Value="1" StepFrequency="0.1" ValueChanged="Settings_Changed"/>
      </StackPanel>
      </ScrollViewer>
    </Grid>
   </Grid>
  </Grid>
 </Grid>
</Window>
