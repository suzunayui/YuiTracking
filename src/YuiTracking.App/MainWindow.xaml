<Window x:Class="YuiTracking.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:Microsoft.UI.Xaml.Controls" Title="YuiTracking">
 <Grid x:Name="Root" Background="#10121B" RequestedTheme="Dark" Padding="16">
  <Grid.Resources>
   <SolidColorBrush x:Key="ButtonBorderBrush" Color="#73FFFFFF"/>
   <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#B3FFFFFF"/>
   <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#99FFFFFF"/>
   <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#2EFFFFFF"/>
   <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="#73FFFFFF"/>
   <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="#B3FFFFFF"/>
   <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="#99FFFFFF"/>
   <SolidColorBrush x:Key="ToggleButtonBorderBrushDisabled" Color="#2EFFFFFF"/>
   <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#73FFFFFF"/>
   <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#B3FFFFFF"/>
   <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#99FFFFFF"/>
   <SolidColorBrush x:Key="RepeatButtonBorderBrush" Color="#73FFFFFF"/>
   <SolidColorBrush x:Key="RepeatButtonBorderBrushPointerOver" Color="#B3FFFFFF"/>
   <SolidColorBrush x:Key="RepeatButtonBorderBrushPressed" Color="#99FFFFFF"/>
   <SolidColorBrush x:Key="RepeatButtonBorderBrushDisabled" Color="#2EFFFFFF"/>
   <SolidColorBrush x:Key="TextControlBorderBrush" Color="#73FFFFFF"/>
   <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#B3FFFFFF"/>
   <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#2EFFFFFF"/>
   <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="#2EFFFFFF"/>
  </Grid.Resources>
  <Grid x:Name="MainContent" ColumnSpacing="16">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="SettingsColumn" Width="300"/></Grid.ColumnDefinitions>
   <Grid x:Name="PreviewPanel" RowSpacing="8">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border x:Name="PreviewBorder" CornerRadius="10" Background="#191D2B" BorderBrush="#2D3447" BorderThickness="1">
     <Grid>
      <controls:WebView2 x:Name="Viewport"/>
      <Border x:Name="StandbyNotice" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="10,5" Background="#E6171B27" BorderBrush="#2D3447" BorderThickness="1" CornerRadius="6">
       <TextBlock Text="待機中：アバターを隠して透過で出力しています" FontSize="12"/>
      </Border>
      <StackPanel x:Name="RendererFailurePanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" Spacing="16" MaxWidth="480">
       <TextBlock Text="描画が停止しました" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <TextBlock x:Name="RendererFailureMessage" Text="アプリを再起動しますか？保存したVRMと設定は引き継がれます。" TextWrapping="Wrap" Foreground="#ADB6CD"/>
       <Button x:Name="RestartButton" ToolTipService.ToolTip="アプリを再起動して、描画の復帰を試みます。&#10;保存済みのアバターと設定を引き継ぎます。" Content="YuiTrackingを再起動する" Click="Restart_Click"/>
      </StackPanel>
     </Grid>
    </Border>
    <Border x:Name="PreviewStatus" Grid.Row="1" Padding="12,8" Background="#1A1E2B" CornerRadius="8">
     <Grid RowSpacing="6">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid ColumnSpacing="6" RowSpacing="6">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Button x:Name="CalibrateButton" Content="キャリブレーション" HorizontalAlignment="Stretch" ToolTipService.ToolTip="今の顔・体の向きと目の開き具合を基準に合わせます。&#10;正面を向いて実行してください。&#10;ショートカット：右Ctrl／右Shift" Click="Calibrate_Click"/>
       <Button x:Name="ResetFramingButton" Grid.Column="1" Content="初期位置に戻す" Click="ResetFraming_Click" ToolTipService.ToolTip="拡大率・移動位置・カメラの回転を、&#10;最初の状態に戻します。"/>
       <Button x:Name="MaximizeButton" Grid.Column="2" Content="最大化" Click="MaximizePreview_Click" ToolTipService.ToolTip="プレビューを最大化します。&#10;Esc：元に戻す&#10;ダブルクリックでも切り替えられます。"/>
       <ToggleButton x:Name="Privacy" Grid.Column="3" VerticalAlignment="Center" Content="待機画面" ToolTipService.ToolTip="アバターを隠します。&#10;オンの間は透過だけを出力します。" Click="Privacy_Click"/>
      </Grid>
      <Grid Grid.Row="1" ColumnSpacing="12">
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MaxWidth="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock x:Name="TrackingStatus" Text="描画エンジンを準備しています…" TextTrimming="CharacterEllipsis" FontSize="12" ToolTipService.ToolTip="{Binding Text, ElementName=TrackingStatus}"/>
       <TextBlock x:Name="OutputStatus" Grid.Column="1" Text="仮想カメラ：停止中" Foreground="#9DA7C0" TextTrimming="CharacterEllipsis" FontSize="12" ToolTipService.ToolTip="{Binding Text, ElementName=OutputStatus}"/>
       <TextBlock x:Name="MemoryStatus" Grid.Column="2" Text="メモリ：計測中" Foreground="#9DA7C0" FontSize="12" ToolTipService.ToolTip="本体と関連WebView2のメモリ使用量を合計します。"/>
      </Grid>
      <Grid Grid.Row="2" ColumnSpacing="12">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock x:Name="CameraInputStatus" Text="カメラ入力：720p / 最大30fps" Foreground="#9DA7C0" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Text, ElementName=CameraInputStatus}"/>
       <TextBlock x:Name="HandDetectionStatus" Grid.Column="1" Text="手：カメラ停止中" Foreground="#9DA7C0" FontSize="12"/>
      </Grid>
     </Grid>
    </Border>
   </Grid>
   <Grid x:Name="SettingsPanel" Grid.Column="1" RowSpacing="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Spacing="6">
     <ComboBox x:Name="Cameras" ToolTipService.ToolTip="トラッキングに使うカメラを選びます。&#10;製品名ではなく「USB 2.0 Camera」などの名前で出る場合があります。" PlaceholderText="カメラを選択" HorizontalAlignment="Stretch" DisplayMemberPath="Label" MaxDropDownHeight="320"/>
     <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button x:Name="TrackButton" ToolTipService.ToolTip="選択したカメラで顔・手・体の認識を開始します。" Content="カメラを開始" Click="Track_Click" IsEnabled="False" HorizontalAlignment="Stretch"/>
      <Button x:Name="RefreshCamerasButton" Grid.Column="1" Content="一覧を更新" Click="RefreshCameras_Click" IsEnabled="False" ToolTipService.ToolTip="接続しているカメラの一覧を取得し直します。トラッキング停止中に使えます。"/>
     </Grid>
       <Button x:Name="OutputButton" Content="仮想カメラ出力を開始" Click="Output_Click" HorizontalAlignment="Stretch" IsEnabled="False" ToolTipService.ToolTip="透過背景のアバター映像を仮想カメラへ出力します。&#10;OBSで「映像キャプチャデバイス」を追加して&#10;「YuiTracking Camera」を選び、&#10;映像フォーマットを「ARGB」にしてください。&#10;必要に応じて解像度/FPSタイプを「カスタム」にし、&#10;解像度を1280×720に設定してください。"/>
       <Button x:Name="RegisterButton" ToolTipService.ToolTip="OBSなどから使える仮想カメラを登録します。&#10;初回のみ実行してください。" Content="仮想カメラを登録（初回）" Click="Register_Click" HorizontalAlignment="Stretch"/>
    </StackPanel>
    <Border Grid.Row="1" BorderBrush="#2D3447" BorderThickness="1" CornerRadius="8" Background="#171B27" Padding="10,10,0,10">
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="SettingsList" Spacing="4" Margin="0,0,14,0">
       <Grid ColumnSpacing="10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="アバター" FontSize="13" FontWeight="SemiBold"/>
        <TextBlock x:Name="ModelLabel" Grid.Column="1" Text="サンプルを準備中" Foreground="#9DA7C0" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Text, ElementName=ModelLabel}"/>
       </Grid>
      <Button x:Name="ModelButton" ToolTipService.ToolTip="PCに保存したVRMファイルを開いて、&#10;使用するアバターを切り替えます。" Content="VRMを開く" HorizontalAlignment="Stretch" Click="OpenModel_Click" IsEnabled="False"/>
       <Button AutomationProperties.Name="サンプル" Click="SamplesToggle_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" ToolTipService.ToolTip="同梱のアバターに切り替えます。&#10;青色のボタンが現在の選択です。">
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBlock Text="サンプル"/>
         <FontIcon x:Name="SamplesChevron" Grid.Column="1" Glyph="&#xE70D;" FontSize="12"/>
        </Grid>
       </Button>
       <Grid x:Name="SampleButtons" ColumnSpacing="6" Visibility="Collapsed">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <ToggleButton x:Name="SampleGirl" ToolTipService.ToolTip="女の子のサンプル（Y）に切り替えます。&#10;選択中のボタンは青色で表示します。" Content="女の子" Tag="Y" Click="Sample_Click" HorizontalAlignment="Stretch" Padding="6,4"/>
       <ToggleButton x:Name="SampleBoy" ToolTipService.ToolTip="男の子のサンプル（Z）に切り替えます。&#10;選択中のボタンは青色で表示します。" Grid.Column="1" Content="男の子" Tag="Z" Click="Sample_Click" HorizontalAlignment="Stretch" Padding="6,4"/>
       <ToggleButton x:Name="SampleRobot" ToolTipService.ToolTip="内蔵ロボットに切り替えます。&#10;選択中のボタンは青色で表示します。" Grid.Column="2" Content="ロボット" Click="Demo_Click" HorizontalAlignment="Stretch" Padding="6,4"/>
       </Grid>
       <TextBlock Text="目線" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,0"/>
       <StackPanel Background="Transparent" ToolTipService.ToolTip="目線対応のVRMで使えます。自分の目に追従する場合は、カメラを見てキャリブレーションしてください。">
        <TextBlock Text="目線モード" Foreground="#9DA7C0" FontSize="12" TextTrimming="CharacterEllipsis"/>
        <ComboBox x:Name="GazeMode" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="GazeMode_Changed">
         <ComboBoxItem Content="自分の目に追従" Tag="tracking"/>
         <ComboBoxItem Content="常にカメラ目線" Tag="camera"/>
         <ComboBoxItem Content="正面固定" Tag="fixed"/>
        </ComboBox>
       </StackPanel>
       <StackPanel Background="Transparent" ToolTipService.ToolTip="追従感度は「自分の目に追従」のときに使います。">
        <TextBlock x:Name="GazeStrengthLabel" Text="目線の追従感度：1.0倍" Foreground="#9DA7C0" FontSize="12" TextTrimming="CharacterEllipsis"/>
        <Slider x:Name="GazeStrength" Minimum="0" Maximum="3" Value="1" StepFrequency="0.1" ValueChanged="FaceSensitivity_Changed"/>
       </StackPanel>
       <StackPanel Background="Transparent" ToolTipService.ToolTip="可動範囲はカメラ目線でも使えます。&#10;1倍でモデル標準、5倍まで拡大できます（目ボーンは最大45度、表情式は表情の最大量まで）。VRMファイルは変更しません。">
        <TextBlock x:Name="GazeRangeLabel" Text="目の可動範囲：1.0倍" Foreground="#9DA7C0" FontSize="12" TextTrimming="CharacterEllipsis"/>
        <Slider x:Name="GazeRange" Minimum="1" Maximum="5" Value="1" StepFrequency="0.1" ValueChanged="FaceSensitivity_Changed"/>
       </StackPanel>
       <TextBlock Text="顔・口" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,0"/>
       <StackPanel Background="Transparent" ToolTipService.ToolTip="認識結果の間を滑らかにつなぎます。&#10;0%：補間なし（比較用）&#10;大きいほど滑らかになり、追従はゆっくりになります。">
        <TextBlock x:Name="SmoothnessLabel" Text="滑らかさ：65%" Foreground="#9DA7C0" FontSize="12" TextTrimming="CharacterEllipsis"/>
        <Slider x:Name="Smoothness" ToolTipService.ToolTip="認識結果の間を滑らかにつなぎます。&#10;0%：補間なし（比較用）&#10;大きいほど滑らかになり、追従はゆっくりになります。" Minimum="0" Maximum="0.95" Value="0.65" StepFrequency="0.05" ValueChanged="Settings_Changed"/>
       </StackPanel>
       <StackPanel Background="Transparent" ToolTipService.ToolTip="頭の向き・傾きを反映する強さです。&#10;1倍：今までと同じ／4倍：顔45度でアバターの顔180度。回転は180度まで。体の強さとは別に調整できます。">
        <TextBlock x:Name="SensitivityLabel" Text="顔の動きの強さ：1.0倍" Foreground="#9DA7C0" FontSize="12" TextTrimming="CharacterEllipsis"/>
        <Slider x:Name="Sensitivity" ToolTipService.ToolTip="頭の向き・傾きを反映する強さです。&#10;1倍：今までと同じ／4倍：顔45度でアバターの顔180度。回転は180度まで。体の強さとは別に調整できます。" Minimum="0.3" Maximum="5" Value="1" StepFrequency="0.1" ValueChanged="FaceSensitivity_Changed"/>
       </StackPanel>
       <StackPanel Background="Transparent" ToolTipService.ToolTip="認識した口の開きに対する、アバターの変形量です。&#10;大きく：アバターの口が大きく開く&#10;小さく：アバターの口の開きが控えめになる">
        <TextBlock x:Name="MouthStrengthLabel" Text="口の開き具合：1.0倍" Foreground="#9DA7C0" FontSize="12" TextTrimming="CharacterEllipsis"/>
        <Slider x:Name="MouthStrength" ToolTipService.ToolTip="認識した口の開きに対する、アバターの変形量です。&#10;大きく：アバターの口が大きく開く&#10;小さく：アバターの口の開きが控えめになる" Minimum="0.5" Maximum="3" Value="1" StepFrequency="0.1" ValueChanged="MouthStrength_Changed"/>
       </StackPanel>
       <StackPanel Background="Transparent" ToolTipService.ToolTip="自分の口の動きを拾う感度を調整します。&#10;大きく：小さな動きでも口が開きやすい&#10;小さく：しっかり口を動かすと反応する">
        <TextBlock x:Name="MouthSensitivityLabel" Text="口の感度：1.8倍" Foreground="#9DA7C0" FontSize="12" TextTrimming="CharacterEllipsis"/>
        <Slider x:Name="MouthSensitivity" ToolTipService.ToolTip="自分の口の動きを拾う感度を調整します。&#10;大きく：小さな動きでも口が開きやすい&#10;小さく：しっかり口を動かすと反応する" Minimum="0.5" Maximum="3" Value="1.8" StepFrequency="0.1" ValueChanged="MouthStrength_Changed"/>
       </StackPanel>
       <TextBlock Text="揺れ" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,0"/>
       <StackPanel Background="Transparent" ToolTipService.ToolTip="モデルに設定された胸・髪・服などの揺れを調整します。">
        <TextBlock x:Name="SpringStrengthLabel" Text="揺れものの強さ：1.0倍" Foreground="#9DA7C0" FontSize="12" TextTrimming="CharacterEllipsis"/>
        <Slider x:Name="SpringStrength" Minimum="0.3" Maximum="5" Value="1" StepFrequency="0.1" ToolTipService.ToolTip="モデルに設定された胸・髪・服などの揺れを調整します。" ValueChanged="SpringStrength_Changed"/>
       </StackPanel>
       <StackPanel Background="Transparent">
        <ToolTipService.ToolTip>
         <ToolTip>
          <StackPanel Spacing="4" MaxWidth="320">
           <TextBlock x:Name="ChestSpringAvailability" Text="胸の揺れ設定を確認中です。" TextWrapping="Wrap"/>
           <TextBlock Text="胸専用の揺れ設定があるモデルで使えます。1倍：現在の揺れ。大きくすると胸だけ揺れが残りやすくなります。全体の揺れものの強さと組み合わせて使います。" TextWrapping="Wrap"/>
          </StackPanel>
         </ToolTip>
        </ToolTipService.ToolTip>
        <TextBlock x:Name="ChestSpringStrengthLabel" Text="胸の揺れやすさ：1.0倍" Foreground="#9DA7C0" FontSize="12" TextTrimming="CharacterEllipsis"/>
        <Slider x:Name="ChestSpringStrength" Minimum="0.3" Maximum="20" Value="1" StepFrequency="0.1" IsEnabled="False" ValueChanged="SpringStrength_Changed"/>
       </StackPanel>
       <TextBlock Text="体" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,0"/>
       <StackPanel Background="Transparent" ToolTipService.ToolTip="頭に連動する体の左右のひねりを調整します。&#10;1倍：今までと同じ／20倍：顔30度で体180度（左右180度まで）。0倍：左右のひねりなし。頭の向き・前後の傾きは変わりません。">
        <TextBlock x:Name="BodyStrengthLabel" Text="体の動きの強さ：1.0倍" Foreground="#9DA7C0" FontSize="12" TextTrimming="CharacterEllipsis"/>
        <Slider x:Name="BodyStrength" Minimum="0" Maximum="20" Value="1" StepFrequency="0.1" ToolTipService.ToolTip="頭に連動する体の左右のひねりを調整します。&#10;1倍：今までと同じ／20倍：顔30度で体180度（左右180度まで）。0倍：左右のひねりなし。頭の向き・前後の傾きは変わりません。" ValueChanged="FaceSensitivity_Changed"/>
       </StackPanel>
       <StackPanel Background="Transparent" ToolTipService.ToolTip="カメラとの距離による体の傾きを調整します。1倍：今までと同じ／0倍：この方向の傾きなし。">
        <TextBlock x:Name="ForwardLeanStrengthLabel" Text="前傾の強さ：1.0倍" Foreground="#9DA7C0" FontSize="12" TextTrimming="CharacterEllipsis"/>
        <Slider x:Name="ForwardLeanStrength" Minimum="0" Maximum="3" Value="1" StepFrequency="0.1" ToolTipService.ToolTip="カメラとの距離による体の傾きを調整します。1倍：今までと同じ／0倍：この方向の傾きなし。" ValueChanged="FaceSensitivity_Changed"/>
       </StackPanel>
       <StackPanel Background="Transparent" ToolTipService.ToolTip="カメラとの距離による体の傾きを調整します。1倍：今までと同じ／0倍：この方向の傾きなし。">
        <TextBlock x:Name="BackwardLeanStrengthLabel" Text="反りの強さ：1.0倍" Foreground="#9DA7C0" FontSize="12" TextTrimming="CharacterEllipsis"/>
        <Slider x:Name="BackwardLeanStrength" Minimum="0" Maximum="3" Value="1" StepFrequency="0.1" ToolTipService.ToolTip="カメラとの距離による体の傾きを調整します。1倍：今までと同じ／0倍：この方向の傾きなし。" ValueChanged="FaceSensitivity_Changed"/>
       </StackPanel>
       <TextBlock Text="ズーム" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,0"/>
       <StackPanel Background="Transparent" ToolTipService.ToolTip="カメラに近づいたときにアバターを大きくする強さです。&#10;0：オフ／大きいほど少ない移動で変化。顔を中心に拡大します。&#10;普段の距離でキャリブレーションしてください。">
        <TextBlock x:Name="NearZoomStrengthLabel" Text="近距離による拡大：オフ" Foreground="#9DA7C0" FontSize="12" TextTrimming="CharacterEllipsis"/>
        <Slider x:Name="NearZoomStrength" Minimum="0" Maximum="20" Value="0" StepFrequency="0.1" ToolTipService.ToolTip="カメラに近づいたときにアバターを大きくする強さです。&#10;0：オフ／大きいほど少ない移動で変化。顔を中心に拡大します。&#10;普段の距離でキャリブレーションしてください。" ValueChanged="FaceSensitivity_Changed"/>
       </StackPanel>
       <StackPanel Background="Transparent" ToolTipService.ToolTip="カメラから離れたときにアバターを小さくする強さです。&#10;0：縮小なし／大きいほど少ない移動で変化。&#10;普段の距離でキャリブレーションしてください。">
        <TextBlock x:Name="FarZoomStrengthLabel" Text="遠距離による縮小：オフ" Foreground="#9DA7C0" FontSize="12" TextTrimming="CharacterEllipsis"/>
        <Slider x:Name="FarZoomStrength" Minimum="0" Maximum="5" Value="0" StepFrequency="0.1" ToolTipService.ToolTip="カメラから離れたときにアバターを小さくする強さです。&#10;0：縮小なし／大きいほど少ない移動で変化。&#10;普段の距離でキャリブレーションしてください。" ValueChanged="FaceSensitivity_Changed"/>
       </StackPanel>
       <StackPanel Background="Transparent" ToolTipService.ToolTip="顔の位置から拡大の中心をずらします。&#10;マイナス：左／プラス：右／0：顔の位置。&#10;100はプレビューの幅の半分です。矢印キーで細かく調整できます。">
        <TextBlock x:Name="ZoomCenterXLabel" Text="拡大の中心（左右）：顔の位置" Foreground="#9DA7C0" FontSize="12" TextTrimming="CharacterEllipsis"/>
        <Slider x:Name="ZoomCenterX" Minimum="-100" Maximum="100" Value="0" StepFrequency="0.1" ToolTipService.ToolTip="顔の位置から拡大の中心をずらします。&#10;マイナス：左／プラス：右／0：顔の位置。&#10;100はプレビューの幅の半分です。矢印キーで細かく調整できます。" ValueChanged="FaceSensitivity_Changed"/>
       </StackPanel>
       <StackPanel Background="Transparent" ToolTipService.ToolTip="顔の位置から拡大の中心をずらします。&#10;マイナス：下／プラス：上／0：顔の位置。&#10;100はプレビューの高さの半分です。矢印キーで細かく調整できます。">
        <TextBlock x:Name="ZoomCenterYLabel" Text="拡大の中心（上下）：顔の位置" Foreground="#9DA7C0" FontSize="12" TextTrimming="CharacterEllipsis"/>
        <Slider x:Name="ZoomCenterY" Minimum="-100" Maximum="100" Value="0" StepFrequency="0.1" ToolTipService.ToolTip="顔の位置から拡大の中心をずらします。&#10;マイナス：下／プラス：上／0：顔の位置。&#10;100はプレビューの高さの半分です。矢印キーで細かく調整できます。" ValueChanged="FaceSensitivity_Changed"/>
       </StackPanel>
       <TextBlock Text="詳細" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,0"/>
       <TextBlock Text="認識に使うデバイス" Foreground="#9DA7C0"/>
       <ComboBox x:Name="RecognitionDevice" DisplayMemberPath="Label" HorizontalAlignment="Stretch" FontSize="12"/>
       <Button Content="認識デバイスを保存" Click="SaveRecognition_Click" HorizontalAlignment="Stretch"/>
       <TextBlock Text="変更はアプリの再起動後に反映します。GPUを選ぶと描画も同じGPUを使います。" TextWrapping="Wrap" FontSize="12" Foreground="#9DA7C0"/>
       <TextBlock x:Name="RecognitionStatus" TextWrapping="Wrap" FontSize="12" Foreground="#9DA7C0"/>
      </StackPanel>
     </ScrollViewer>
    </Border>
   </Grid>
  </Grid>
 </Grid>
</Window>
