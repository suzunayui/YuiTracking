<Window x:Class="HoloTrack.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:Microsoft.UI.Xaml.Controls" Title="YuiTracking — VTuber Studio">
 <Grid x:Name="Root" Background="#10121B" RequestedTheme="Dark" Padding="28" RowSpacing="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><StackPanel><TextBlock Text="YuiTracking" FontSize="28" FontWeight="SemiBold" CharacterSpacing="130"/><TextBlock Text="顔と手で、アバターに命を。" Foreground="#939CB5" Margin="0,6,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#1C2930" CornerRadius="18" Padding="16,9"><TextBlock Text="●  アバター専用出力" Foreground="#83E2C0"/></Border></Grid>
  <Grid Grid.Row="1" ColumnSpacing="22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
   <Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><TextBlock Text="PROGRAM / 配信プレビュー" Foreground="#ADB6CD" FontSize="12"/><TextBlock Text="1280 × 720 · 最大60fps" HorizontalAlignment="Right" Foreground="#818AA2" FontSize="12"/></Grid>
    <Border Grid.Row="1" CornerRadius="12" Background="#191D2B" BorderBrush="#2D3447" BorderThickness="1"><controls:WebView2 x:Name="Viewport"/></Border>
    <Border Grid.Row="2" Padding="16" Background="#1A1E2B" CornerRadius="10"><StackPanel Spacing="8"><TextBlock x:Name="TrackingStatus" Text="描画エンジンを準備しています…" TextWrapping="Wrap"/><TextBlock x:Name="OutputStatus" Text="仮想カメラ：停止中" Foreground="#9DA7C0" TextWrapping="Wrap"/><ToggleSwitch x:Name="Privacy" Header="緊急待機画面" OffContent="通常" OnContent="待機画面を出力中" Toggled="Privacy_Toggled"/></StackPanel></Border>
   </Grid>
   <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel Spacing="18">
    <StackPanel Spacing="8"><TextBlock Text="01  アバター" FontSize="16" FontWeight="SemiBold"/><Button x:Name="ModelButton" Content="VRMファイルを開く" HorizontalAlignment="Stretch" Click="OpenModel_Click" IsEnabled="False"/><TextBlock x:Name="ModelLabel" Text="内蔵サンプル・ロボット" Foreground="#9DA7C0" TextTrimming="CharacterEllipsis"/><Button Content="サンプルに戻す" Click="Demo_Click"/></StackPanel>
    <StackPanel Spacing="8"><TextBlock Text="02  トラッキング" FontSize="16" FontWeight="SemiBold"/><ComboBox x:Name="Cameras" PlaceholderText="開始時にカメラを取得" HorizontalAlignment="Stretch" DisplayMemberPath="Label"/><Button x:Name="TrackButton" Content="カメラを開始" HorizontalAlignment="Stretch" Click="Track_Click" IsEnabled="False"/><TextBlock x:Name="CameraInputStatus" Text="カメラ入力：720p / 最大30fps" Foreground="#9DA7C0" FontSize="12" TextWrapping="Wrap"/><Button Content="正面をキャリブレーション" Click="Calibrate_Click"/><TextBlock Text="滑らかさ" Foreground="#9DA7C0"/><Slider x:Name="Smoothness" Minimum="0" Maximum="0.95" Value="0.65" StepFrequency="0.05" ValueChanged="Settings_Changed"/><TextBlock x:Name="MouthStrengthLabel" Text="口の開き具合：1.0倍" Foreground="#9DA7C0"/><Slider x:Name="MouthStrength" ToolTipService.ToolTip="アバターの口の変形量を調整" Minimum="0.5" Maximum="3" Value="1" StepFrequency="0.1" ValueChanged="MouthStrength_Changed"/><TextBlock x:Name="MouthSensitivityLabel" Text="口の感度：1.8倍" Foreground="#9DA7C0"/><Slider x:Name="MouthSensitivity" ToolTipService.ToolTip="小さな口の動きへの反応を調整" Minimum="0.5" Maximum="3" Value="1.8" StepFrequency="0.1" ValueChanged="MouthStrength_Changed"/><TextBlock x:Name="SpringStrengthLabel" Text="揺れものの強さ：1.0倍" Foreground="#9DA7C0"/><Slider x:Name="SpringStrength" Minimum="0.3" Maximum="3" Value="1" StepFrequency="0.1" ToolTipService.ToolTip="1.0倍がモデル標準。大きくすると髪・服が揺れやすくなります。" ValueChanged="SpringStrength_Changed"/><TextBlock Text="顔の動きの強さ" Foreground="#9DA7C0"/><Slider x:Name="Sensitivity" Minimum="0.3" Maximum="2" Value="1" StepFrequency="0.1" ValueChanged="Settings_Changed"/></StackPanel>
    <StackPanel Spacing="8"><TextBlock Text="03  配信出力" FontSize="16" FontWeight="SemiBold"/><ComboBox x:Name="Background" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="Background_Changed"><ComboBoxItem Content="クロマキー・グリーン" Tag="#00ff00"/><ComboBoxItem Content="クロマキー・ブルー" Tag="#0000ff"/><ComboBoxItem Content="ミッドナイト" Tag="#171b2e"/></ComboBox><Button x:Name="RegisterButton" Content="仮想カメラを登録（初回）" Click="Register_Click" HorizontalAlignment="Stretch"/><Button x:Name="OutputButton" Content="仮想カメラ出力を開始" Click="Output_Click" HorizontalAlignment="Stretch" IsEnabled="False"/><TextBlock Text="OBS → 映像キャプチャデバイス → YuiTracking Camera" Foreground="#9DA7C0" TextWrapping="Wrap" FontSize="12"/></StackPanel>
   </StackPanel></ScrollViewer>
  </Grid>
  <TextBlock Grid.Row="2" Text="LOCAL PROCESSING  /  実写映像は認識にのみ使用。配信出力にはアバターと背景だけを描画します。" Foreground="#79849D" FontSize="12" TextWrapping="Wrap"/>
 </Grid>
</Window>
